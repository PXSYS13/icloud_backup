# Папка, куда складывать фото и видео из iCloud (можно сменить в интерфейсе)
DOWNLOAD_DIR=D:/iCloudBackup
# Ключ доступа к Яндекс Диску — только если хотите заливать туда копию (см. README)
YA_DISK_TOKEN=
# Порт интерфейса; обычно менять не нужно
ICLOUD_BK_PORT=8000
# Формат фото: originals (HEIC как есть), jpg (JPG-копии, HEIC в _heic_originals), both (JPG рядом с HEIC)
PHOTO_FORMAT=originals
# 1 — папки по годам и месяцам (2023/2023-07), 0 — все файлы в одну папку
LAYOUT_BY_MONTH=1
